# Node API
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
ML_URL=http://127.0.0.1:5001
# DATABASE_PATH=./chest_x_ai.db
# Python inference service
ML_PORT=5001
MODEL_PATH=models/weights/weights.best.05-1.74.hdf5




1. Start the Flask ML Microservice (Port 5001)
powershell
python ml_service/app.py
2. Start the Express API Backend (Port 4000)
powershell
node server/index.js
3. Start the Frontend Client (Port 5173)
powershell
cd client
npm run dev
