{
  "name": "chestx-ai",
  "private": true,
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install && pip install -r requirements.txt",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev:api": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "ml": "python ml_service/app.py",
    "test": "npm --prefix server test && python tests/ml_test.py",
    "test:backend": "npm --prefix server test",
    "test:ml": "python tests/ml_test.py",
    "test:e2e": "python tests/verify_e2e_workflow.py"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}
